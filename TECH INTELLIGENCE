}


/* =========================================================
   MATH ENGINE
========================================================= */

function calculate(expression){

    expression =
    expression
    .replace(/×/g,"*")
    .replace(/÷/g,"/")
    .replace(/\^/g,"**");

    expression =
    expression.replace(
        /sqrt\s*\(\s*([0-9.]+)\s*\)/gi,
        "Math.sqrt($1)"
    );

    expression =
    expression.replace(
        /(\d+(?:\.\d+)?)\s*%\s*of\s*(\d+(?:\.\d+)?)/gi,
        "($1/100*$2)"
    );

    if(
        !/^[0-9+\-*/().%\s**Math.sqrt]+$/i.test(
        expression
        )
    ){

        throw new Error(
        "Unsafe mathematical expression"
        );
    }

    return Function(
        '"use strict";return (' +
        expression +
        ')'
    )();
}

function solveMath(){

    const input =
    document.getElementById(
    "mathInput"
    ).value.trim();

    const result =
    document.getElementById(
    "mathResult"
    );

    if(!input){

        result.textContent =
        "Enter a mathematical problem.";

        return;
    }

    try{

        result.textContent =
        "Answer: " +
        calculate(input);

    }catch(error){

        result.textContent =
        "Could not solve this expression.";
    }
}


