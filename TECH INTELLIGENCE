<button class="action"
onclick="speakText(document.getElementById('voiceText').value)">
🔊 Speak
</button>

<button class="action secondary"
onclick="speechSynthesis.cancel()">
⏹ Stop
</button>

</div>

</section>

<!-- =========================
     MATH
========================= -->

<section id="mathTool" class="tools">

<div class="card">

<h2>🧮 Mathematics Solver</h2>

<p>Examples: 25*10+50, sqrt(144), 15% of 500</p>

<input
id="mathInput"
placeholder="Enter mathematical problem"
>

<button class="action" onclick="solveMath()">
Solve
</button>

<div id="mathResult" class="result"></div>

</div>

</section>

<!-- =========================
     IMAGE
========================= -->

<section id="imageTool" class="tools">

<div class="card">

<h2>🖼️ Background Changer</h2>

<p>
Upload an image and select a replacement background.
</p>

<input
type="file"
id="imageInput"
accept="image/*"
onchange="loadImage(event)"
>

<select id="backgroundChoice">

<option value="blur">
Blur Background
</option>

<option value="#001f3f">
Dark Blue
</option>

<option value="#111111">
Black
</option>

<option value="#ffffff">
White
</option>

<option value="#00a86b">
Green
</option>

</select>

<br>

<button class="action" onclick="changeBackground()">
Change Background
</button>

<br><br>

<canvas id="imageCanvas"></canvas>

</div>

</section>

<!-- =========================
     SCANNER
========================= -->

<section id="scanTool" class="tools">

<div class="card">

<h2>📷 Object Scanner</h2>

<p>
Use your camera to scan an object.
</p>

<video id="cameraVideo"
autoplay
playsinline></video>

<br>

<button class="action" onclick="startCamera()">
Start Camera
</button>

<button class="action" onclick="captureObject()">
Scan Object
</button>

<canvas id="cameraCanvas"></canvas>

<div id="scanResult" class="result">
Object detection result will appear here.
</div>

</div>

</section>

<!-- =========================
     PRODUCT SEARCH
========================= -->

<section id="productTool" class="tools">

<div class="card">

<h2>🛒 Product Search</h2>

<p>
Search an identified item on e-commerce websites.
</p>

<input
id="productInput"
placeholder="Example: Samsung Galaxy phone"
>

<button class="action"
onclick="searchAmazon()">
Amazon
</button>

<button class="action"
onclick="searchFlipkart()">
Flipkart
</button>

<button class="action"
onclick="searchGoogleShopping()">
Google Shopping
</button>

<div class="result">
TI can generate product-search links.
Actual prices and availability should be verified on the retailer's website.
</div>

</div>

</section>

<!-- =========================
     TIME
========================= -->

<section id="timeTool" class="tools">

<div class="card">

<h2>🕐 Date & Time</h2>

<p>Current system date and time:</p>

<div id="clockResult" class="result"></div>

<button class="action" onclick="updateClock()">
Refresh
</button>

</div>

</section>

</div>

</main>

</div>

