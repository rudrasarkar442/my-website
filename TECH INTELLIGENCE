let originalImage = null;


function loadImage(event) {

    const file =
        event.target.files[0];

    if(!file) return;


    const reader =
        new FileReader();


    reader.onload = function(e) {

        const img =
            new Image();


        img.onload = function() {

            originalImage =
                img;


            const canvas =
                document.getElementById("canvas");


            canvas.width =
                img.width;

            canvas.height =
                img.height;


            const ctx =
                canvas.getContext("2d");


            ctx.drawImage(
                img,
                0,
                0
            );

        };


        img.src =
            e.target.result;

    };


    reader.readAsDataURL(file);

}


/*
   Simple background replacement.

   This version does NOT perform AI subject segmentation.
   It replaces the outer/background area approximately
   using pixel similarity.

   For professional background removal, connect
   a segmentation AI model/API.
*/

function changeImageBackground() {

    if(!originalImage) {

        alert("Please upload an image first.");

        return;

    }


    const canvas =
        document.getElementById("canvas");


    const ctx =
        canvas.getContext("2d");


    ctx.drawImage(
        originalImage,
        0,
        0
    );


    const imageData =
        ctx.getImageData(
            0,
            0,
            canvas.width,
            canvas.height
        );


    const pixels =
        imageData.data;


    const bg =
        document.getElementById(
            "backgroundColor"
        ).value;


    const r =
        parseInt(bg.substring(1,3),16);

    const g =
        parseInt(bg.substring(3,5),16);

    const b =
        parseInt(bg.substring(5,7),16);


    /*
       Very simple edge/background algorithm.
       It is intended as a demonstration.
    */

    const sample =
        getPixel(
            pixels,
            canvas.width,
            0,
            0
        );


    for(let y=0; y<canvas.height; y++) {

        for(let x=0; x<canvas.width; x++) {

            const index =
                (y * canvas.width + x) * 4;


            const pr =
                pixels[index];

            const pg =
                pixels[index+1];

            const pb =
                pixels[index+2];


            const difference =
                Math.abs(pr-sample.r) +
                Math.abs(pg-sample.g) +
                Math.abs(pb-sample.b);


            if(difference < 90) {

                pixels[index] =
                    r;

                pixels[index+1] =
                    g;

                pixels[index+2] =
                    b;

            }

        }

    }


    ctx.putImageData(
        imageData,
        0,
        0
    );

}


function getPixel(
    pixels,
    width,
    x,
    y
) {

    const index =
        (y * width + x) * 4;


    return {

        r:pixels[index],

        g:pixels[index+1],

        b:pixels[index+2]

    };

}


function downloadImage() {

    const canvas =
        document.getElementById("canvas");


    const link =
        document.createElement("a");


    link.download =
        "TI-background-image.png";


    link.href =
        canvas.toDataURL("image/png");


