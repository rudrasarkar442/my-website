/* =========================================================
   TRANSLATION REQUEST DETECTION
========================================================= */

function detectTranslationRequest(text){

    const lower =
    text.toLowerCase();

    let language = null;

    for(const lang of languages){

        if(
            lower.includes(
            lang.toLowerCase()
            )
        ){

            language = lang;

            break;
        }
    }

    if(!language) return null;

    const markers = [
        "translate",
        "translation",
        "convert"
    ];

    const isRequest =
    markers.some(
        m => lower.includes(m)
    );

    if(!isRequest) return null;

    let translatedText =
    text
    .replace(/translate/ig,"")
    .replace(/translation/ig,"")
    .replace(/convert/ig,"")
    .replace(
        new RegExp(
        "into\\s+" +
        language,
        "ig"
        ),
        ""
    )
    .replace(
        new RegExp(
        "to\\s+" +
        language,
        "ig"
        ),
        ""
    )
    .trim();

    return {
        text:translatedText,
        language:language
    };
}


