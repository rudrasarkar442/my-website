<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TECH INTELLIGENCE - TI AI Assistant</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:#0a0f18;
    color:#fff;
    height:100vh;
    overflow:hidden;
}

.app{
    display:flex;
    height:100vh;
}

/* =========================
   SIDEBAR
========================= */

.sidebar{
    width:270px;
    background:#101722;
    border-right:1px solid #273244;
    padding:20px;
    display:flex;
    flex-direction:column;
    overflow-y:auto;
}

.logo{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:25px;
}

.logoIcon{
    width:45px;
    height:45px;
    border-radius:12px;
    background:linear-gradient(135deg,#00eaff,#0066ff);
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:bold;
    color:white;
    box-shadow:0 0 20px #008cff88;
}

.logoText{
    font-size:18px;
    font-weight:bold;
}

.logoText small{
    display:block;
    color:#7d8ba1;
    font-size:11px;
    margin-top:3px;
}

.menuTitle{
    color:#728096;
    font-size:11px;
    margin:12px 5px;
    text-transform:uppercase;
}

.menu button{
    width:100%;
    border:0;
    background:transparent;
    color:#c9d3e3;
    padding:12px;
    margin:3px 0;
    border-radius:10px;
    text-align:left;
    cursor:pointer;
    transition:.2s;
}

.menu button:hover,
.menu button.active{
    background:#1b2b40;
    color:#00eaff;
}

.status{
    margin-top:auto;
    background:#111d2b;
    padding:12px;
    border-radius:12px;
    color:#8fa1b7;
    font-size:12px;
}

.status span{
    color:#35e77a;
}

/* =========================
   MAIN
========================= */

.main{
    flex:1;
    display:flex;
    flex-direction:column;
    min-width:0;
}

.header{
    height:70px;
    padding:15px 25px;
    border-bottom:1px solid #273244;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.headerTitle{
    font-size:20px;
    font-weight:bold;
}

.headerTitle span{
    color:#00eaff;
}

.headerStatus{
    color:#7f8ea4;
    font-size:13px;
}

.content{
    flex:1;
    display:flex;
    flex-direction:column;
    min-height:0;
}

.chat{
    flex:1;
    overflow-y:auto;
    padding:25px;
}

.message{
    display:flex;
    margin-bottom:20px;
}

.message.user{
    justify-content:flex-end;
}

.bubble{
    max-width:750px;
    padding:15px 17px;
    border-radius:15px;
    line-height:1.5;
    white-space:pre-wrap;
}

.ai .bubble{
    background:#141e2c;
    border:1px solid #26374d;
}

.user .bubble{
    background:#0759a8;
}

.aiIcon{
    width:34px;
    height:34px;
    background:#00a9ff;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    margin-right:10px;
    flex-shrink:0;
    font-size:13px;
    font-weight:bold;
}

.tools{
    display:none;
    padding:20px;
    overflow:auto;
}

.tools.active{
    display:block;
}

.card{
    background:#111b29;
    border:1px solid #263448;
    border-radius:15px;
    padding:20px;
    margin-bottom:15px;
}

.card h2{
    margin-bottom:10px;
    color:#00eaff;
}

.card p{
    color:#9eabc0;
    margin-bottom:15px;
}

textarea,
input,
select{
    width:100%;
    background:#0b121c;
    border:1px solid #2b3b50;
    color:white;
    padding:12px;
    border-radius:9px;
    outline:none;
    margin-bottom:10px;
}

textarea{
    min-height:130px;
    resize:vertical;
}

button.action{
    background:#008cff;
    color:white;
    border:0;
    padding:11px 17px;
    border-radius:9px;
    cursor:pointer;
    margin:4px;
}

button.action:hover{
    background:#00a9ff;
}

button.secondary{
    background:#1c2939;
}

/* =========================
   INPUT
========================= */

.inputArea{
    border-top:1px solid #273244;
    padding:15px 20px;
}

.inputBox{
    display:flex;
    align-items:flex-end;
    gap:8px;
    background:#111a27;
    border:1px solid #29394e;
    border-radius:14px;
    padding:8px;
}

#userInput{
    flex:1;
    border:0;
    margin:0;
    resize:none;
    min-height:45px;
    max-height:130px;
    background:transparent;
}

.iconBtn{
    width:43px;
    height:43px;
    border:0;
    border-radius:10px;
    background:#1b293b;
    color:white;
    cursor:pointer;
}

.iconBtn:hover{
    background:#263c56;
}

.sendBtn{
    background:#008cff;
}

.preview{
    max-width:400px;
    max-height:250px;
    border-radius:12px;
    margin-top:10px;
}

/* =========================
   IMAGE TOOL
========================= */

.imageArea{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
}

.imageArea img,
#cameraVideo,
#cameraCanvas{
    width:320px;
    max-width:100%;
    border-radius:12px;
    border:1px solid #304158;
}

#cameraCanvas{
    display:none;
}

.result{
    background:#0b121c;
    border:1px solid #263448;
    border-radius:10px;
    padding:15px;
    margin-top:10px;
    color:#b8c4d5;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:800px){
    .sidebar{
        width:70px;
        padding:10px;
    }

    .logoText,
    .menuTitle,
    .menu button span,
    .status{
        display:none;
    }

    .logo{
        justify-content:center;
    }

    .menu button{
        text-align:center;
        font-size:18px;
    }

    .header{
        padding:15px;
    }

    .chat{
        padding:15px;
    }
}
